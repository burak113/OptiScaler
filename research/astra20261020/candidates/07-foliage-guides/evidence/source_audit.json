  "pipeline_findings": [
    {
      "claim": "Native packed guide is R10G10B10A2_UNORM. World-space oct normal uses bits0..19, linear roughness bits20..29, category bits30..31.",
      "evidence": [
        "FSRDPreprocessCommon.hlsli:47-58",
        "FSRDNrdBridgePass_Dx12.cpp:248",
        "fixtures/clips/README.md"
      ]
    },
    {
      "claim": "Native categorical A preserves only an equality code under independent preserveNativeMaterialIDs option; it is not a foliage classifier.",
      "evidence": [
        "FSRDNrdBridge.hlsl:102-104",
        "FSRDNrdBridgeGeometry.hlsl:80-81",
        "FSRDNrdBridgePass_Dx12.cpp:464",
        "FSRDNrdBridgeRR_Dx12.h:117"
      ]
    },
    {
      "claim": "Native material guide validity restricts category3 to white fallback because of an unavailable late-compositor branch; category0..2 still do not provide vegetation semantics.",
      "evidence": [
        "FSRDNrdMaterialGuides.hlsli:4-17"
      ]
    },
    {
      "claim": "Optional material capture decodes squared base RGB and metallic R, optionally roughness G, rounds half nearest-even explicitly, and does not read or demodulate physical D/S.",
      "evidence": [
        "FSRDNrdNativeMaterialCapture.hlsl:13-23",
        "FSRDNrdNativeMaterialParamsCapture.hlsl:24-27",
        "FSRDNrdMaterialQuantization.hlsli:6-23"
      ]
    },
    {
      "claim": "Existing native geometry validity is a separate R8_UINT texture: class bits0..1 and raw-negative bit2, never a repurposed material/normal/depth channel.",
      "evidence": [
        "FSRDNrdBridgeGeometry.hlsl:32-43,68-77",
        "FSRDNrdBridgePass_Dx12.cpp:447-448"
      ]
    },
    {
      "claim": "Native Anchor private physical D/S feed RR and recovery/NZR, whereas G3 LightingGuard reads the unmodified sourceInput D/S.",
      "evidence": [
        "FSRDNrdBridgeRR_Dx12.cpp:1295-1337,1569-1573"
      ]
    },
    {
      "claim": "Examined provider dispatch has seven texture inputs and no guide uncertainty sidecar input. LightingGuard modifies motion B only after a confirmed light-change test; this is not a general uncertainty API.",
      "evidence": [
        "FSRDNrdBridgeRR_Dx12.cpp:1238-1241,1540-1554,1573",
        "FSRDNrdLightingGuardApply.hlsl:48-65"
      ]
    },
    {
      "claim": "Trace captures actual provider normals/motion and explicit pre-flat original normal when active; original pre-G3 motion and raw depth-class sidecar are not clip roles.",
      "evidence": [
        "FSRDGameTraceSession.cpp:2074-2077,2112-2120",
        "FSRDNrdBridgeRR_Dx12.cpp:1686-1689"
      ]
    },
    {
      "claim": "Provider control suffix has 46 original uint32 words. The three clip intervals have NON_GAMMA flag2 with no reset and consecutive SDK counters distinct from local capture indices.",
      "evidence": [
        "FSRDGameTraceSession.cpp:33-46",
        "clip_inventory"
      ]
    },
    {
      "claim": "Source trace can record QPC metadata, but packaged clip NPZs do not carry frame durations or timestamps. CPU captured temporal measurements are per-frame, not per-second.",
      "evidence": [
        "FSRDGameTraceSession.cpp:2163",
        "clip_inventory"
      ]
    }
  ],
  "recommended_integration_boundary": {
    "mode": "default_off_diagnostic_only",
    "observe": "original normal/roughness, existing signed depth and physical-UV motion with explicit source authority and provenance",
    "preserve": [
      "all packed guide bits",
      "depth",
      "all motion components",
      "physical D/S RGB",
      "input hit-distance alpha",
      "albedo semantics",
      "D16/S256 + G2/G3 + NZR configuration"
    ],
    "sidecar": "independent observation texture(s) and flags; unsupported implies no consumer change; uncertainty zero without supported flag is not a confidence guarantee",
    "consumer": "job04 may transport a separately versioned observation with same domain/frame/crop validity; job08 may integrate only after local contracts; no AMD input substitution is justified"
  },
  "limitations": [
    "Normal and roughness bit identity cannot prove that the original native encoding is physically correct. A known-normal writer witness remains necessary.",
    "Spatial normal dispersion is equally compatible with valid bump normals, rigid geometric detail and mixed coverage.",
    "No per-sample coverage, per-layer geometry/motion, sampling-randomness witness or converged same-pose truth exists in clips.",
    "Stored RR outputs carry unseen pre-crop history and are not executable AMD temporal replays.",
    "Glass fields are mixed coordinate spaces; original geometry must not be treated as already aligned to the stored RGB.",
    "recovery_original_normal_roughness is original relative to Flat Albedo, already bridge-converted, and not an unmodified native writer/per-sample GBuffer dump; categorical preservation mode remains a required witness."
  ]
}
